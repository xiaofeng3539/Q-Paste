{
  "name": "q-paste",
  "version": "1.4.1",
  "description": "Q-Paste - 跨平台剪贴板管理工具",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "predev": "pnpm run build:floral",
    "dev": "vite",
    "build:floral": "tsc --noEmit -p vendor/floral-notepaper/tsconfig.json && vite build --config vendor/floral-notepaper/vite.config.ts",
    "build": "tsc && vite build && tsc --noEmit -p vendor/floral-notepaper/tsconfig.json && vite build --config vendor/floral-notepaper/vite.config.ts && electron-builder",
    "build:win": "tsc && vite build && tsc --noEmit -p vendor/floral-notepaper/tsconfig.json && vite build --config vendor/floral-notepaper/vite.config.ts && electron-builder --win",
    "build:win:web": "tsc && vite build && npm run build:floral && electron-builder --win nsis-web --x64 --publish never --config.directories.output=release/web-installer",
    "verify:win": "npm test && npm --prefix vendor/floral-notepaper test && node --test tests/installer-packaging.test.cjs",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.11",
    "koffi": "3.3.8",
    "lucide-react": "^0.468.0",
    "pinyin-pro": "^3.29.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sortablejs": "^1.15.7",
    "tailwind-merge": "^2.6.0",
    "tesseract.js": "5.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "45.4.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "sql.js": "^1.12.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.qpaste.app",
    "productName": "Q-Paste",
    "artifactName": "${productName}.Setup.v${version}.${ext}",
    "compression": "maximum",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "xiaofeng3539",
        "repo": "Q-Paste"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!**/*.map",
      "!node_modules/lucide-react/dist/**/*",
      "!node_modules/{react,react-dom}/cjs/**/*",
      "!node_modules/{pinyin-pro,sortablejs}/dist/**/*",
      "!node_modules/zlibjs/bin/**/*",
      "!node_modules/koffi/{doc,vendor}/**/*",
      "!node_modules/tesseract.js/{dist,src}/**/*",
      "!node_modules/tesseract.js-core/*.wasm*"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/tray-icon.ico",
        "to": "tray-icon.ico"
      },
      {
        "from": "build/ocr",
        "to": "ocr",
        "filter": [
          "worker.min.js",
          "chi_sim.traineddata.gz",
          "eng.traineddata.gz",
          "core/tesseract-core-lstm.wasm.js",
          "core/tesseract-core-simd-lstm.wasm.js"
        ]
      },
      {
        "from": "vendor/floral-notepaper/LICENSE",
        "to": "licenses/floral-notepaper-LICENSE"
      },
      {
        "from": "vendor/floral-notepaper/THIRD_PARTY_NOTICES.md",
        "to": "licenses/floral-notepaper-THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "vendor/floral-notepaper/UPSTREAM.md",
        "to": "licenses/floral-notepaper-UPSTREAM.md"
      },
      {
        "from": "vendor/floral-notepaper/src/assets/fonts/LICENSE_Fonts",
        "to": "licenses/HarmonyOS-Sans-License"
      },
      {
        "from": "vendor/floral-notepaper/src/assets/fonts/LICENSE_SourceHanSerif",
        "to": "licenses/Source-Han-Serif-License"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "electronLanguages": [
        "en-US",
        "zh-CN",
        "zh-TW"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Q-Paste"
    },
    "nsisWeb": {
      "artifactName": "${productName}.WebSetup.v${version}.${ext}"
    }
  }
}
